NODE_ENV=production
DATABASE_NAME=asnm-db
GEMINI_API_KEY=
# Additional comma-separated keys from separate Gemini projects.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash-lite
BROWSER_EXECUTABLE_PATH=
BROWSER_HEADLESS=false
OPEN_WEBSEARCH_URL=
OPEN_WEBSEARCH_PORT=3210
OPEN_WEBSEARCH_ENGINE=duckduckgo
MAX_SITE_PAGES=20
MAX_MARKDOWN_CHARS=100000
SITE_REQUEST_INTERVAL_MS=1000
SEARCH_INTERVAL_MS=5000
GEMINI_REQUESTS_PER_MINUTE=10
GEMINI_REQUESTS_PER_DAY=500
# Long-lived non-interactive Wrangler credentials. Keep the real values only in prod.env.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=