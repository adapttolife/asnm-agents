NODE_ENV=production
DATABASE_NAME=asnm-db
GEMINI_API_KEY=
# Additional comma-separated keys from separate Gemini projects.
GEMINI_API_KEYS=
GEMINI_MODEL=gemma-4-26b-a4b-it
# Comma-separated fallbacks, used only after all keys reach the primary model's daily quota.
GEMINI_BACKUP_MODELS=gemma-4-31b-it
BROWSER_EXECUTABLE_PATH=
BROWSER_HEADLESS=true
OPEN_WEBSEARCH_URL=
OPEN_WEBSEARCH_PORT=3210
OPEN_WEBSEARCH_ENGINES=duckduckgo,bing,brave
MAX_SITE_PAGES=25
MAX_MARKDOWN_CHARS=150000
SITE_REQUEST_INTERVAL_MS=1000
MAX_CRAWL_DURATION_MS=60000
SEARCH_INTERVAL_MS=5000
GEMINI_REQUESTS_PER_MINUTE=30
GEMINI_REQUESTS_PER_DAY=14000
RUN_INTERVAL_MS=3600000
# Long-lived non-interactive Wrangler credentials. Keep the real values only in prod.env.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
